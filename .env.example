# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Supabase Configuration (Configure via AI Studio Secrets panel)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Cloud SQL / External PostgreSQL (e.g., Vercel + Supabase Postgres, Railway, Render, VPS)
# On Vercel / Supabase you can set either DATABASE_URL alone OR the SQL_* variables below:
DATABASE_URL=""
PORT="3000"
SQL_HOST=""
SQL_PORT="5432"
SQL_DB_NAME=""
SQL_USER=""
SQL_PASSWORD=""
SQL_SSL="false"
SQL_ADMIN_USER=""
SQL_ADMIN_PASSWORD=""

# Optional Payment Gateway Credentials (Do not activate until configured by Super Admin)
PAYMOB_API_KEY=""
PAYMOB_INTEGRATION_ID=""
PAYMOB_HMAC_SECRET=""
FAWRY_MERCHANT_CODE=""
FAWRY_SECURITY_KEY=""
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""
PAYPAL_MODE="sandbox"
